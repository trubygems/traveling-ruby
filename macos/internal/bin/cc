#!/bin/bash
set -e
CC=(/usr/bin/cc)
ARGS=()
REGEX='(^| )-c( |$)'
# A relocatable link (-r), as YJIT does, takes no -rpath
RELOCATABLE='(^| )-r( |$)'

if [[ "$RUNTIME_DIR" != "" && -e "$RUNTIME_DIR/bin/ccache" ]]; then
	CC=("$RUNTIME_DIR/bin/ccache" /usr/bin/cc)
fi
if [[ "$@" =~ $REGEX || "$@" =~ $RELOCATABLE ]]; then
	if [[ "$RUNTIME_DIR" != "" ]]; then
		ARGS+=("-I$RUNTIME_DIR/include")
	fi
	exec "${CC[@]}" "${ARGS[@]}" "$@"
else
	if [[ "$DEAD_STRIP" != "" ]] && $DEAD_STRIP; then
		ARGS+=(-Wl,-dead_strip)
	fi
	if [[ "$RUNTIME_DIR" != "" ]]; then
		ARGS+=(-rpath "$RUNTIME_DIR/lib" "-L$RUNTIME_DIR/lib")
	fi
	exec "${CC[@]}" \
		-Wl,-headerpad_max_install_names \
		-rpath "@executable_path/../lib" \
		-rpath "@loader_path" \
		"${ARGS[@]}" "$@"
fi
